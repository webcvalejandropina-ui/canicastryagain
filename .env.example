# Public canonical origin, including port when nonstandard. Required behind HTTPS termination.
# Leave empty only for local HTTP development.
PUBLIC_ORIGIN=
# Maximum concurrent SSE streams per Node process; overflow uses HTTP fallback.
GAME_STREAM_LIMIT=1000
# SQLite must be on local persistent storage, never on NFS or shared between machines.
# SQLITE_PATH=/app/data/game.db
